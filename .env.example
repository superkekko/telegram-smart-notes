# Copy this file to ".env" and fill in the real values.
# The ".env" file must NEVER be committed to Git (it is already excluded by .gitignore).

# Google Gemini API key — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Telegram bot token, obtained from @BotFather
TELEGRAM_BOT_TOKEN=

# Telegram chat IDs authorized as "Master Admin" (comma-separated, e.g. "12345678,98765432")
# To find your chat ID you can message the @userinfobot bot on Telegram.
AUTHORIZED_CHAT_IDS=

# Public URL of the dashboard (used in the link generated by the /login command).
# It must be HTTPS and publicly reachable to open as a Telegram Mini App.
DASHBOARD_URL=http://localhost:3000

# Port on which the web service is exposed (both inside the container and on the host)
WEB_PORT=3000

# Language of the bot and the dashboard: one of the files in /locales (en, it, ...)
LANGUAGE=en

# Timezone for deadlines, notifications and the daily summary (IANA name, e.g. Europe/Rome, America/New_York)
TIMEZONE=UTC
