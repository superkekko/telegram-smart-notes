# Copia questo file in ".env" e compila i valori reali.
# Il file ".env" NON va mai committato su Git (è già escluso da .gitignore).

# Chiave API di Google Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Token del bot Telegram, ottenuto da @BotFather
TELEGRAM_BOT_TOKEN=

# ID chat Telegram autorizzati come "Master Admin" (separati da virgola, es. "12345678,98765432")
# Per trovare il tuo chat ID puoi scrivere al bot @userinfobot su Telegram.
AUTHORIZED_CHAT_IDS=

# URL pubblico su cui è raggiungibile la dashboard (usato nel link generato dal comando /login)
DASHBOARD_URL=http://localhost:3000

# Porta su cui esporre il servizio web (sia dentro il container che sull'host)
WEB_PORT=3000
